<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppDebugToolkit" parent="Theme.MaterialComponents.DayNight.NoActionBar.DarkActionBar">
        <item name="colorPrimary">#e94560</item>
        <item name="colorPrimaryVariant">#c23152</item>
        <item name="colorSecondary">#0f3460</item>
        <item name="colorSecondaryVariant">#0a2540</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorOnSecondary">#ffffff</item>
        <item name="android:colorBackground">#1a1a2e</item>
        <item name="android:statusBarColor">#16213e</item>
        <item name="android:navigationBarColor">#16213e</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    
    <style name="Theme.AppDebugToolkit.Transparent" parent="Theme.AppDebugToolkit">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <!-- Overlay theme for floating window mode -->
    <style name="Theme.AppDebugToolkit.Overlay" parent="Theme.AppDebugToolkit">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">#cc1a1a2e</item>
    </style>
</resources>
